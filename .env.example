# OpenStreetMap PBF extract filename or path (located in data/ or root)
# If the corresponding .drive.fastest.graph.pickle exists, it will be loaded automatically.
OSM_PBF_PATH=map.osm.pbf

# Allowed CORS origins for the FastAPI backend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Map bounding box [min_lon, min_lat, max_lon, max_lat]
MAP_BOUNDS=26.6,45.4,30.2,48.6

# Internal backend URL used by Next.js server for API proxy rewrites
API_INTERNAL_URL=http://localhost:8000

# Optional: Direct backend URL for client-side fetches (leave empty to use Next.js /api rewrite proxy)
NEXT_PUBLIC_API_URL=
